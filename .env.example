# Base URL of the news API (the playchangefoundation-api service on Render).
# No trailing slash. Set the same value in Vercel's environment variables.
NEXT_PUBLIC_API_URL=https://playchange-api.onrender.com

# Shared secret for the API's revalidation webhook, so publishing or removing
# content updates the site in about a second instead of waiting out the cache.
# Must match REVALIDATE_SECRET on the API. Generate: openssl rand -base64 32
REVALIDATE_SECRET=

# Google Search Console verification token (the value from the "HTML tag"
# verification method, not the whole meta tag). Renders the verification meta
# tag on every page. Without a verified property there is no way to submit the
# sitemap or see which searches the site appears in.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
